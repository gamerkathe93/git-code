generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  name         String
  bio          String   @default("")
  avatarUrl    String   @default("")
  website      String   @default("")
  company      String   @default("")
  location     String   @default("")
  isAdmin              Boolean   @default(false)
  emailVerified        Boolean   @default(false)
  passwordResetToken   String?
  passwordResetExpiry  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repositories  Repository[]
  issues        Issue[]        @relation("IssueAuthor")
  pullRequests  PullRequest[]  @relation("PRAuthor")
  comments      Comment[]
  stars         Star[]
  notifications Notification[]
  pipelines      Pipeline[]
  organizations    Organization[]
  orgMemberships   OrgMember[]
  issueAssignments IssueAssignee[] @relation("IssueAssignee")
  releases      Release[]      @relation("ReleaseAuthor")
  wikiPages     WikiPage[]     @relation("WikiAuthor")
  prReviews     PRReviewer[]   @relation("PRReviewer")
  accessTokens  PersonalAccessToken[]
  sshKeys       SSHKey[]
  reactions     Reaction[]
  presence      Presence[]
}

model Repository {
  id            String   @id @default(cuid())
  name          String
  description   String   @default("")
  isPrivate     Boolean  @default(false)
  defaultBranch String   @default("main")
  language      String   @default("")
  topics        String   @default("") // JSON array
  license       String   @default("")
  hasIssues     Boolean  @default(true)
  hasWiki       Boolean  @default(true)
  forksCount    Int      @default(0)
  starsCount    Int      @default(0)
  watchersCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pushedAt      DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  issues            Issue[]
  pullRequests      PullRequest[]
  labels            Label[]
  milestones        Milestone[]
  stars             Star[]
  pipelines         Pipeline[]
  webhooks          Webhook[]
  releases          Release[]
  wikiPages         WikiPage[]
  branchProtections BranchProtection[]

  @@unique([ownerId, name])
}

model Issue {
  id           String   @id @default(cuid())
  number       Int
  title        String
  body         String   @default("")
  state        String   @default("open") // open | closed
  kanbanColumn String   @default("backlog") // backlog | todo | in_progress | in_review | done
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  closedAt     DateTime?

  repoId   String
  repo     Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  authorId String
  author   User       @relation("IssueAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])

  labels    IssueLabel[]
  assignees IssueAssignee[]
  comments  Comment[]

  @@unique([repoId, number])
}

model IssueLabel {
  issueId String
  labelId String
  issue   Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

model IssueAssignee {
  issueId    String
  assigneeId String
  issue      Issue  @relation(fields: [issueId], references: [id], onDelete: Cascade)
  assignee   User   @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  @@id([issueId, assigneeId])
}

model PullRequest {
  id          String    @id @default(cuid())
  number      Int
  title       String
  body        String    @default("")
  state       String    @default("open") // open | closed | merged
  headBranch  String
  baseBranch  String
  isDraft     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?
  mergedAt    DateTime?

  repoId   String
  repo     Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  authorId String
  author   User       @relation("PRAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  comments  Comment[]
  labels    PRLabel[]
  reviewers PRReviewer[]

  @@unique([repoId, number])
}

model PRLabel {
  pullRequestId String
  labelId       String
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  label         Label       @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([pullRequestId, labelId])
}

model PRReviewer {
  id            String      @id @default(cuid())
  pullRequestId String
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User        @relation("PRReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  state         String      @default("requested") // requested | approved | changes_requested
  body          String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([pullRequestId, reviewerId])
}

model Label {
  id          String @id @default(cuid())
  name        String
  color       String
  description String @default("")

  repoId String
  repo   Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  issues IssueLabel[]
  prs    PRLabel[]

  @@unique([repoId, name])
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  dueDate     DateTime?
  state       String    @default("open")
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  repoId String
  repo   Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  issues Issue[]
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Inline diff comment fields (PR reviews)
  path      String?  // file path e.g. "src/foo.ts"
  lineRef   Int?     // line number in the diff
  side      String?  // "LEFT" or "RIGHT"
  commitSha String?  // commit the comment is anchored to

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  issueId       String?
  issue         Issue?       @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pullRequestId String?
  pullRequest   PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  reactions Reaction[]
}

model Reaction {
  id        String   @id @default(cuid())
  emoji     String   // e.g. "👍" "❤️" "😄" "🎉" "👀" "🚀"
  createdAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId, emoji])
}

model Star {
  userId    String
  repoId    String
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  repo Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@id([userId, repoId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // mention | review_request | push | issue | pull_request | pipeline
  title     String
  body      String   @default("")
  isRead    Boolean  @default(false)
  url       String   @default("")
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Presence {
  id       String   @id @default(cuid())
  pageKey  String   // e.g. "owner/repo/pulls/1" or "owner/repo/issues/5"
  lastSeen DateTime @default(now())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pageKey])
}

model Pipeline {
  id        String   @id @default(cuid())
  status    String   @default("pending") // pending | running | success | failed | canceled
  branch    String
  commitSha String   @default("")
  commitMsg String   @default("")
  source    String   @default("push") // push | manual | schedule | api
  duration  Int      @default(0) // seconds
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repoId    String
  repo      Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  triggerId String?
  trigger   User?      @relation(fields: [triggerId], references: [id], onDelete: SetNull)

  jobs PipelineJob[]
}

model PipelineJob {
  id        String   @id @default(cuid())
  name      String
  stage     String
  status    String   @default("pending")
  logs      String   @default("")
  duration  Int      @default(0)
  startedAt DateTime?
  finishedAt DateTime?

  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  secret    String   @default("")
  events    String   @default("push") // JSON array
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  repoId    String
  repo      Repository      @relation(fields: [repoId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  event        String
  status       Int      // HTTP status code
  requestBody  String   @default("")
  responseBody String   @default("")
  duration     Int      @default(0) // ms
  createdAt    DateTime @default(now())

  webhookId String
  webhook   Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model Organization {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  description String   @default("")
  avatarUrl   String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  members OrgMember[]
}

model OrgMember {
  role      String   @default("member") // owner | member
  joinedAt  DateTime @default(now())

  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
}

model Release {
  id           String   @id @default(cuid())
  tagName      String
  name         String   @default("")
  body         String   @default("")
  isDraft      Boolean  @default(false)
  isPrerelease Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  repoId   String
  repo     Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  authorId String
  author   User       @relation("ReleaseAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  @@unique([repoId, tagName])
}

model WikiPage {
  id        String   @id @default(cuid())
  slug      String
  title     String
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  repoId   String
  repo     Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)
  authorId String
  author   User       @relation("WikiAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  @@unique([repoId, slug])
}

model PersonalAccessToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String    // first 8 chars shown after creation
  scopes      String    @default("repo") // comma-separated: repo, issues, admin
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SSHKey {
  id          String   @id @default(cuid())
  title       String
  keyType     String   // ssh-rsa, ssh-ed25519, etc.
  keyBody     String   // the actual public key
  fingerprint String
  lastUsedAt  DateTime?
  createdAt   DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BranchProtection {
  id                     String   @id @default(cuid())
  pattern                String   // e.g. "main" or "release/*"
  requirePullRequest     Boolean  @default(true)
  requiredApprovals      Int      @default(1)
  requireStatusChecks    Boolean  @default(false)
  dismissStaleReviews    Boolean  @default(false)
  restrictPushAccess     Boolean  @default(false)
  allowForcePush         Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  repoId String
  repo   Repository @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@unique([repoId, pattern])
}
